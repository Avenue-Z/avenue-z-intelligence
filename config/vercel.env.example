# Server-only values. Configure through the organization's Vercel secret settings.
# This file contains names and placeholders, never actual credentials.
APP_ORGANIZATION_ID=avenue-z
APP_BOOTSTRAP_ADMIN_EMAIL=administrator@your-company.example
AUTH_URL=https://your-production-domain.example
AUTH_SECRET=<at-least-32-random-characters>
AUTH_GOOGLE_ID=<organization-owned-Google-OAuth-client-id>
AUTH_GOOGLE_SECRET=<organization-owned-Google-OAuth-client-secret>
# Optional verified Google Workspace onboarding; both must be configured.
# Exact Google hd claim and email domain must match. Never grant '*' here.
APP_GOOGLE_WORKSPACE_DOMAIN=avenuez.com
APP_GOOGLE_WORKSPACE_CLIENT_IDS=kind-patches
TURSO_DATABASE_URL=<organization-owned-libsql-database-url>
TURSO_AUTH_TOKEN=<database-service-token>
BLOB_READ_WRITE_TOKEN=<private-Blob-store-token>
CRON_SECRET=<at-least-32-random-characters-different-from-AUTH_SECRET>
SOURCE_KIND_PATCHES_SCRIPT=<validated-Kind-Patches-provider-configuration-JSON>
OPENAI_API_KEY=<organization-owned-OpenAI-project-key>
# Optional; retain the project's configured model or set explicitly.
OPENAI_MODEL=gpt-5.4-mini
